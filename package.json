{
  "name": "meetqueue",
  "private": true,
  "description": "Scheduling and booking: weekly availability, timezone-aware booking pages, Google Calendar sync.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @meetqueue/api --filter @meetqueue/web dev",
    "build": "pnpm --filter @meetqueue/api --filter @meetqueue/web build",
    "lint": "pnpm -r lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "pnpm --filter @meetqueue/web test:e2e",
    "db:migrate": "pnpm --filter @meetqueue/api db:deploy",
    "db:seed": "pnpm --filter @meetqueue/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
