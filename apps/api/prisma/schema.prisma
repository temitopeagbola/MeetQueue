// MeetQueue data model. The double-booking exclusion constraint and check constraints live in
// raw SQL inside the migration (Prisma's schema language can't express them).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  timezone     String   @default("UTC")
  isDemo       Boolean  @default(false) @map("is_demo")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  availability       AvailabilityRule[]
  meetingTypes       MeetingType[]
  bookings           Booking[]
  calendarConnection CalendarConnection?
  emailLogs          EmailLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A weekly window of availability in the host's timezone.
model AvailabilityRule {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
  @@map("availability_rules")
}

model MeetingType {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  slug                String
  title               String
  description         String?
  location            String?
  durationMinutes     Int      @map("duration_minutes")
  bufferBeforeMinutes Int      @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int      @default(0) @map("buffer_after_minutes")
  slotIntervalMinutes Int      @default(30) @map("slot_interval_minutes")
  minNoticeMinutes    Int      @default(240) @map("min_notice_minutes")
  maxDaysAhead        Int      @default(60) @map("max_days_ahead")
  color               String   @default("#4f46e5")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([userId, slug])
  @@map("meeting_types")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum CancelledBy {
  HOST
  INVITEE
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  hostId          String        @map("host_id") @db.Uuid
  meetingTypeId   String        @map("meeting_type_id") @db.Uuid
  status          BookingStatus @default(CONFIRMED)
  inviteeName     String        @map("invitee_name")
  inviteeEmail    String        @map("invitee_email")
  inviteeTimezone String        @map("invitee_timezone")
  notes           String?
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  /// starts_at minus the buffer before; compared by the exclusion constraint
  blockedStart    DateTime      @map("blocked_start") @db.Timestamptz(3)
  /// ends_at plus the buffer after; compared by the exclusion constraint
  blockedEnd      DateTime      @map("blocked_end") @db.Timestamptz(3)
  /// SHA-256 of the invitee's manage-link token (the raw token is never stored)
  manageTokenHash String        @unique @map("manage_token_hash")
  /// 'google' | 'mock' when an event was created in the host's calendar
  calendarProvider String?      @map("calendar_provider")
  calendarEventId String?       @map("calendar_event_id")
  /// iCalendar SEQUENCE, bumped on every reschedule/cancel
  icsSequence     Int           @default(0) @map("ics_sequence")
  rescheduleCount Int           @default(0) @map("reschedule_count")
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     CancelledBy?  @map("cancelled_by")
  cancelReason    String?       @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  host        User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  meetingType MeetingType @relation(fields: [meetingTypeId], references: [id], onDelete: Restrict)
  emailLogs   EmailLog[]

  @@index([hostId, startsAt])
  @@index([meetingTypeId])
  @@map("bookings")
}

model CalendarConnection {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  /// 'google' | 'mock'
  provider        String
  accountEmail    String    @map("account_email")
  /// AES-256-GCM encrypted (see src/lib/crypto.ts)
  accessTokenEnc  String?   @map("access_token_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamptz(3)
  calendarId      String    @default("primary") @map("calendar_id")
  /// Last sync failure (e.g. expired or revoked Google access); cleared after a success
  lastError       String?   @map("last_error")
  lastErrorAt     DateTime? @map("last_error_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_connections")
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

model EmailLog {
  id        String      @id @default(uuid()) @db.Uuid
  /// Host whose dashboard shows this email
  userId    String      @map("user_id") @db.Uuid
  bookingId String?     @map("booking_id") @db.Uuid
  to        String
  subject   String
  kind      String
  provider  String
  status    EmailStatus
  hasIcs    Boolean     @default(false) @map("has_ics")
  /// Plain-text body with manage-link tokens redacted
  bodyText  String      @map("body_text")
  error     String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("email_logs")
}
