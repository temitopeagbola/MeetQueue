# MeetQueue environment variables. Copy to `.env.local` in the repo root for local development
# (`apps/api` reads .env.local, then .env; docker-compose sets its own values). Both files are
# gitignored: never commit real secrets. Add every new variable name here.

# ── API (apps/api) ─────────────────────────────────────────────────────────────────────────
# Postgres connection used at runtime. Neon: the *pooled* connection string, ?sslmode=require.
DATABASE_URL=postgresql://meetqueue:meetqueue@localhost:5432/meetqueue
# Optional direct (non-pooled) connection for `prisma migrate deploy`. Neon: the direct host.
DIRECT_DATABASE_URL=
# Reference copies of the production Neon URLs (pooled / direct), kept out of DATABASE_URL so
# local dev, seeds and tests never touch production. Not read by the app; copy them into Render.
NEON_DATABASE_URL=
NEON_DIRECT_DATABASE_URL=
# Postgres database used by the API integration tests (created and migrated automatically).
TEST_DATABASE_URL=postgresql://meetqueue:meetqueue@localhost:5432/meetqueue_test
# Port and bind address (Render sets PORT itself).
PORT=4000
HOST=0.0.0.0
# Public URL of the web app: CORS/origin check, links in emails, default OAuth redirect.
WEB_ORIGIN=http://localhost:3000
# Mark cookies Secure. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Trust X-Forwarded-For from the proxy in front (Netlify/Render). Default true.
TRUST_PROXY=true
# Secret used to encrypt OAuth tokens at rest. Required in production with Google enabled.
TOKEN_ENCRYPTION_KEY=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Calendar provider: google | mock. Unset = google when both credentials below exist, else mock.
CALENDAR_PROVIDER=
# Google Cloud OAuth client (Web application). App can stay in "Testing" with listed test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${WEB_ORIGIN}/api/integrations/google/callback (must match the OAuth client).
GOOGLE_REDIRECT_URI=

# Email provider: smtp | console. Unset = smtp when SMTP_URL is set, else console (log only).
EMAIL_PROVIDER=
# e.g. smtp://user:pass@smtp-relay.brevo.com:587 or smtp://localhost:1025 (Mailpit)
SMTP_URL=
EMAIL_FROM=MeetQueue <no-reply@meetqueue.local>

# Enable the shared demo account and POST /api/auth/demo. Default true.
DEMO_ENABLED=true
# In-memory rate limiting. Default true (tests turn it off).
RATE_LIMIT_ENABLED=true
# Docker image only: reseed the demo host on boot.
RUN_SEED=false

# ── Web (apps/web) ─────────────────────────────────────────────────────────────────────────
# Where Next.js proxies /api/* (read at build time). Netlify: your Render URL.
API_URL=http://localhost:4000
